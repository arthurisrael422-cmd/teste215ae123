#============================================================
# Build by Terasic System Builder & Refactored for top_module
#============================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY "top_module"
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 15.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 780
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 7
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85

#============================================================
# MAIN CLOCK & INPUTS
#============================================================
set_location_assignment PIN_Y2 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

set_location_assignment PIN_M23 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# KEY [3:0]
set_location_assignment PIN_R24 -to key[3]
set_location_assignment PIN_N21 -to key[2]
set_location_assignment PIN_M21 -to key[1]
set_location_assignment PIN_M23 -to key[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[0]

# LED [3:0]
set_location_assignment PIN_F21 -to led[3]
set_location_assignment PIN_E19 -to led[2]
set_location_assignment PIN_F19 -to led[1]
set_location_assignment PIN_G19 -to led[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to led[3]
set_instance_assignment -name IO_STANDARD "2.5 V" -to led[2]
set_instance_assignment -name IO_STANDARD "2.5 V" -to led[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to led[0]

#============================================================
# CAMERA OV7670 INTERFACE (GPIO CONNECTOR)
#============================================================
set_location_assignment PIN_AB22 -to cmos_db[0]
set_location_assignment PIN_AC15 -to cmos_db[1]
set_location_assignment PIN_AB21 -to cmos_db[2]
set_location_assignment PIN_Y17 -to cmos_db[3]
set_location_assignment PIN_AC21 -to cmos_db[4]
set_location_assignment PIN_Y16 -to cmos_db[5]
set_location_assignment PIN_AD21 -to cmos_db[6]
set_location_assignment PIN_AE16 -to cmos_db[7]
set_location_assignment PIN_AD15 -to cmos_pclk
set_location_assignment PIN_AE15 -to cmos_xclk
set_location_assignment PIN_AC19 -to cmos_vsync
set_location_assignment PIN_AF16 -to cmos_href
set_location_assignment PIN_AD19 -to cmos_rst_n
set_location_assignment PIN_AF15 -to cmos_pwdn
set_location_assignment PIN_AF24 -to cmos_sda
set_location_assignment PIN_AE21 -to cmos_scl

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_db[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_pclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_xclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_vsync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_href
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_pwdn
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cmos_scl

#============================================================
# VGA OUTPUT INTERFACE (ONBOARD VGA DAC)
#============================================================
set_location_assignment PIN_G13 -to vga_out_hs
set_location_assignment PIN_C13 -to vga_out_vs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_hs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_vs

# VGA RED [4:0] - Mapped to high-order DAC lines
set_location_assignment PIN_G10 -to vga_out_r[4]
set_location_assignment PIN_F12 -to vga_out_r[3]
set_location_assignment PIN_D10 -to vga_out_r[2]
set_location_assignment PIN_E11 -to vga_out_r[1]
set_location_assignment PIN_E12 -to vga_out_r[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_r[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_r[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_r[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_r[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_r[0]

# VGA GREEN [5:0] - Mapped to high-order DAC lines
set_location_assignment PIN_F10 -to vga_out_g[5]
set_location_assignment PIN_B8 -to vga_out_g[4]
set_location_assignment PIN_C8 -to vga_out_g[3]
set_location_assignment PIN_H12 -to vga_out_g[2]
set_location_assignment PIN_F8 -to vga_out_g[1]
set_location_assignment PIN_G11 -to vga_out_g[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_g[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_g[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_g[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_g[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_g[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_g[0]

# VGA BLUE [4:0] - Mapped to high-order DAC lines
set_location_assignment PIN_A11 -to vga_out_b[4]
set_location_assignment PIN_B11 -to vga_out_b[3]
set_location_assignment PIN_C11 -to vga_out_b[2]
set_location_assignment PIN_A10 -to vga_out_b[1]
set_location_assignment PIN_B10 -to vga_out_b[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_b[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_b[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_b[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_b[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_out_b[0]

#============================================================
# SDRAM CHIP INTERFACE (ONBOARD SDRAM)
#============================================================
set_location_assignment PIN_AA7 -to sdram_clk
set_location_assignment PIN_AA6 -to sdram_cke
set_location_assignment PIN_T4 -to sdram_cs_n
set_location_assignment PIN_U6 -to sdram_ras_n
set_location_assignment PIN_V7 -to sdram_cas_n
set_location_assignment PIN_V6 -to sdram_we_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cke
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cs_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_ras_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cas_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_we_n

# SDRAM ADDRESS BUS [12:0]
set_location_assignment PIN_Y7 -to sdram_addr[12]
set_location_assignment PIN_W5 -to sdram_addr[11]
set_location_assignment PIN_AA5 -to sdram_addr[10]
set_location_assignment PIN_Z7 -to sdram_addr[9]
set_location_assignment PIN_Y6 -to sdram_addr[8]
set_location_assignment PIN_Y5 -to sdram_addr[7]
set_location_assignment PIN_W7 -to sdram_addr[6]
set_location_assignment PIN_W8 -to sdram_addr[5]
set_location_assignment PIN_V5 -to sdram_addr[4]
set_location_assignment PIN_P1 -to sdram_addr[3]
set_location_assignment PIN_U8 -to sdram_addr[2]
set_location_assignment PIN_V8 -to sdram_addr[1]
set_location_assignment PIN_R6 -to sdram_addr[0]

# SDRAM BANK ADDRESS [1:0]
set_location_assignment PIN_R4 -to sdram_ba[1]
set_location_assignment PIN_U7 -to sdram_ba[0]

# SDRAM DATA MASK [1:0]
set_location_assignment PIN_W4 -to sdram_dqm[1]
set_location_assignment PIN_U2 -to sdram_dqm[0]

# SDRAM DATA BUS [15:0]
set_location_assignment PIN_AC2 -to sdram_dq[15]
set_location_assignment PIN_AB3 -to sdram_dq[14]
set_location_assignment PIN_AC1 -to sdram_dq[13]
set_location_assignment PIN_AB2 -to sdram_dq[12]
set_location_assignment PIN_AA3 -to sdram_dq[11]
set_location_assignment PIN_AB1 -to sdram_dq[10]
set_location_assignment PIN_Y4 -to sdram_dq[9]
set_location_assignment PIN_Y3 -to sdram_dq[8]
set_location_assignment PIN_U3 -to sdram_dq[7]
set_location_assignment PIN_V1 -to sdram_dq[6]
set_location_assignment PIN_V2 -to sdram_dq[5]
set_location_assignment PIN_V3 -to sdram_dq[4]
set_location_assignment PIN_W1 -to sdram_dq[3]
set_location_assignment PIN_V4 -to sdram_dq[2]
set_location_assignment PIN_W2 -to sdram_dq[1]
set_location_assignment PIN_W3 -to sdram_dq[0]


set_global_assignment -name EDA_SIMULATION_TOOL "<None>"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/vga_interface.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/vga_core.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/top_module.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/sdram_interface.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/sdram_controller.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/i2c_top.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/debounce_explicit.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/camera_interface.v"
set_global_assignment -name VERILOG_FILE "codigo/FPGA_OV7670_Camera_Interface-main/src/asyn_fifo.v"
set_global_assignment -name VERILOG_FILE pll_sdram.v
set_global_assignment -name VERILOG_FILE meu_pll.v
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ov7670_siod
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ov7670_sioc